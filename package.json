{
  "name": "angel",
  "version": "1.20.0",
  "private": true,
  "description": "ANGEL — bot Discord di sicurezza avanzata con pannello web di controllo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run generate -w @angel/db",
    "db:push": "npm run push -w @angel/db",
    "db:migrate": "npm run migrate -w @angel/db",
    "db:studio": "npm run studio -w @angel/db",
    "dev:bot": "npm run dev -w @angel/bot",
    "dev:api": "npm run dev -w @angel/api",
    "dev:web": "npm run dev -w @angel/web",
    "dev:worker": "npm run dev -w @angel/worker",
    "commands:deploy": "npm run commands:deploy -w @angel/bot",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
