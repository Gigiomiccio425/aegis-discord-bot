# Aegis — reverse proxy
#
# SITE_ADDRESS controlla il comportamento:
#   :80                    → solo HTTP, accesso via IP in rete locale
#   aegis.tuodominio.it    → HTTPS automatico con Let's Encrypt (porte 80 e 443
#                            devono essere raggiungibili dall'esterno)
#
# L'API Fastify serve sia le rotte /api/* sia il pannello React compilato,
# quindi qui basta un unico reverse_proxy.

{$SITE_ADDRESS} {
	encode zstd gzip

	# Header di sicurezza. Il pannello non carica nulla da domini esterni
	# tranne le immagini avatar/emoji dalla CDN Discord.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# Il WebSocket del feed live passa dallo stesso host.
	reverse_proxy api:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}
