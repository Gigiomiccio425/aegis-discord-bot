# ─────────────────────────────────────────────────────────────
#  ANGEL — i valori da compilare
#
#      cp .env.esempio .env
#      nano .env
#      docker compose up -d
#
#  ⚠️ `.env` contiene segreti in chiaro. Non finisce in git (c'è una riga
#     apposta nel .gitignore), e non va passato su canali che conservano i
#     messaggi.
#
#  Ogni riga qui sotto va compilata. Le sezioni marcate «facoltativo» si
#  possono lasciare vuote: quelle funzioni restano spente e il resto
#  funziona lo stesso.
# ─────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════
#  1. DISCORD — https://discord.com/developers/applications
# ═════════════════════════════════════════════════════════════

# Sezione Bot → Reset Token.
#
# Nella stessa pagina attiva **tutti e tre** i Privileged Gateway Intents:
# Presence, Server Members e Message Content. Se ne manca anche uno solo
# Discord rifiuta la connessione con «Used disallowed intents» e il bot
# riparte in ciclo senza collegarsi mai.
DISCORD_TOKEN=

# Sezione General Information → Application ID.
DISCORD_CLIENT_ID=

# Sezione OAuth2 → Client Secret. Serve solo al pannello.
DISCORD_CLIENT_SECRET=

# Il tuo ID Discord: Impostazioni → Avanzate → Modalità sviluppatore, poi
# tasto destro sul tuo nome → Copia ID utente. Più ID separati da virgola.
OWNER_IDS=

# Riserva il pannello agli ID qui sopra. Con 'false' entra chiunque abbia
# «Gestisci server» su un server dove il bot è presente: per
# un'installazione personale va tenuto acceso.
PANEL_OWNERS_ONLY=true


# ═════════════════════════════════════════════════════════════
#  2. INDIRIZZI
# ═════════════════════════════════════════════════════════════

# Da dove aprirai il pannello Discord. Deve combaciare **esattamente** con
# quello che digiterai nel browser, porta compresa, e va registrato come
# redirect OAuth2 su Discord con /api/auth/callback in fondo.
#
# Su Umbrel l'indirizzo della macchina è di solito umbrel.local:
#   http://umbrel.local:780
# Se non risolve, usa l'indirizzo IP:
#   http://192.168.1.50:780
PUBLIC_URL=http://umbrel.local:780


# ═════════════════════════════════════════════════════════════
#  3. DATABASE E SEGRETI
# ═════════════════════════════════════════════════════════════

# Inventala, non serve ricordarla: nessuno la digiterà.
#
# ⚠️ Va scritta in DUE punti — qui e dentro DATABASE_URL — e devono
#    coincidere. Se ci fosse un modo di scriverla una volta sola lo userei:
#    Postgres vuole la password come variabile propria, e l'applicazione la
#    vuole dentro l'URL di connessione.
DB_PASSWORD=CAMBIA_QUESTA_PASSWORD
DATABASE_URL=postgresql://angel:CAMBIA_QUESTA_PASSWORD@angel-postgres:5432/angel?schema=public

# Due segreti DIVERSI fra loro. Generali con:
#     openssl rand -hex 32
#
# Il primo firma i cookie del pannello. Il secondo cifra i token dentro il
# database: perderlo significa che i token delle integrazioni diventano
# illeggibili, e nessun ripristino li recupera.
SESSION_SECRET=
ENCRYPTION_KEY=


# ═════════════════════════════════════════════════════════════
#  4. COPIE DI SICUREZZA
# ═════════════════════════════════════════════════════════════

# Ogni notte alle 4:15 ANGEL esporta se stesso in ./copie.
BACKUP_KEEP=14
# Include allegati archiviati e trascrizioni dei ticket. Senza, il database
# ripristinato è pieno di riferimenti a file che non esistono più.
BACKUP_INCLUDE_STORAGE=true
# Oltre questa dimensione l'archivio viene escluso invece che troncato, e
# il motivo finisce nel manifesto. Un archivio a metà è la cosa che sembra
# un backup e non lo è.
BACKUP_STORAGE_MAX_MB=4096


# ═════════════════════════════════════════════════════════════
#  5. SCANNER (facoltativo)
# ═════════════════════════════════════════════════════════════

# Senza chiave, lo scanner usa le sole blocklist locali — che sono già
# centinaia di migliaia di domini aggiornati ogni sei ore.
GOOGLE_SAFE_BROWSING_KEY=
ABUSECH_AUTH_KEY=
THREAT_FEEDS_ENABLED=true


# ═════════════════════════════════════════════════════════════
#  6. BOT TWITCH (facoltativo)
# ═════════════════════════════════════════════════════════════
#
# Un secondo bot dentro lo stesso container: modera la chat Twitch e fa
# quello che fa un bot di chat. Senza queste variabili resta spento e non
# disturba nessuno.
#
# L'APPLICAZIONE — https://dev.twitch.tv/console/apps
# Come «OAuth Redirect URL» va TWITCH_PUBLIC_URL + /api/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Serve solo agli annunci di diretta su Discord, non al bot di chat.
TWITCH_EVENTSUB_SECRET=

# L'indirizzo del pannello degli streamer.
#
# A differenza di quello Discord, questo è fatto per stare su Internet: è
# lì che gli streamer vanno a collegare il proprio canale. Su Umbrel la
# strada pulita è un tunnel Cloudflare su un sottodominio, che dà anche
# HTTPS senza aprire porte sul router — un pannello che chiede un accesso
# Twitch su HTTP in chiaro insegna un'abitudine pericolosa.
TWITCH_PUBLIC_URL=http://umbrel.local:781
TWITCH_PANEL_PORT=781

# L'ACCOUNT da cui il bot parla in chat.
#
# È un account Twitch normale — creane uno col nome del tuo bot — che
# autorizza l'applicazione una volta sola. Senza, il bot legge la chat ma
# non può scrivere: per parlare serve una bocca.
#
# Per ottenere i quattro valori non serve fare niente a mano: metti una
# parola qualsiasi in TWITCH_SETUP_KEY, riavvia, e dal browser in cui hai
# fatto l'accesso con l'account bot apri
#
#     TWITCH_PUBLIC_URL/api/auth/bot?chiave=LA_PAROLA
#
# La pagina che torna li mostra pronti da incollare. Poi **svuota
# TWITCH_SETUP_KEY**: finché c'è, chi la indovina può rifare lo stesso giro.
TWITCH_SETUP_KEY=
TWITCH_BOT_USER_ID=
TWITCH_BOT_LOGIN=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=


# ═════════════════════════════════════════════════════════════
#  7. RIPRISTINO DA UN TRASLOCO
# ═════════════════════════════════════════════════════════════
#
# Per riportare qui i dati di un'altra installazione: copia la cartella
# `trasloco-…` dentro ./copie, togli il cancelletto alla riga sotto con il
# nome giusto, riavvia. Poi rimetti il cancelletto.
#
# ⚠️ ENCRYPTION_KEY deve essere quella della macchina di provenienza,
#    altrimenti i token delle integrazioni restano illeggibili — e il
#    ripristino si ferma per dirtelo.
#
# RESTORE_FROM=/backup/trasloco-2026-09-02T22-40-00
# RESTORE_OVERWRITE=1


# ═════════════════════════════════════════════════════════════
#  8. VARIE
# ═════════════════════════════════════════════════════════════

LOG_LEVEL=info
# Fuso orario: decide a che ora escono il rapporto giornaliero e le copie.
TZ=Europe/Rome
