# ─────────────────────────────────────────────────────────────
#  AEGIS — configurazione
#  Copia questo file in `.env` e compila i valori.
#  NON committare mai il file .env.
# ─────────────────────────────────────────────────────────────

# ── Discord ──────────────────────────────────────────────────
# https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# ID Discord dei proprietari del bot (separati da virgola).
# Hanno accesso completo al pannello e ai comandi di emergenza.
OWNER_IDS=

# Guild di sviluppo: i comandi slash vengono registrati qui
# istantaneamente invece che globalmente (propagazione ~1h).
DEV_GUILD_ID=

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=aegis
POSTGRES_PASSWORD=cambiami_con_una_password_lunga
POSTGRES_DB=aegis
# In Docker l'host è il nome del servizio; in locale usa localhost:5432
DATABASE_URL=postgresql://aegis:cambiami_con_una_password_lunga@postgres:5432/aegis?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── API / Pannello ───────────────────────────────────────────
API_PORT=8080

# Porte pubblicate sull'host dal reverse proxy. Volutamente fuori dagli
# standard: 780 e 781 non sono usate da servizi diffusi, quindi non entrano in
# conflitto con ZimaOS (porta 80), SSH, DNS, mail o database.
HTTP_PORT=780
HTTPS_PORT=781

# Come rispondere alle richieste. Tre possibilità:
#   :80                              solo HTTP, accesso via http://IP:780
#   aegis.tuodominio.it              HTTPS automatico (richiede 80 e 443 pubbliche)
#   https://aegis.tuodominio.it:781  HTTPS su porta non standard
SITE_ADDRESS=:80

# Certificato TLS. Lascia vuoto per Let's Encrypt automatico.
# Su porte non standard il certificato automatico NON funziona: usa
#   TLS_DIRECTIVE=tls internal
# che genera un certificato autofirmato (il browser avvisa una volta sola).
TLS_DIRECTIVE=

# URL pubblico da cui è raggiungibile il pannello. Deve combaciare esattamente
# con l'indirizzo che digiti nel browser, porta compresa: è usato per il
# redirect OAuth2 di Discord e per il callback EventSub di Twitch.
#   http://192.168.1.50:780
#   https://aegis.tuodominio.it:781
PUBLIC_URL=http://localhost:8080
# Origine del frontend in sviluppo (Vite)
WEB_DEV_ORIGIN=http://localhost:5173

# Segreto per firmare i cookie di sessione del pannello.
# Genera con:  openssl rand -hex 32
SESSION_SECRET=

# Chiave di cifratura a riposo per token e segreti salvati nel DB (32 byte hex).
# Genera con:  openssl rand -hex 32
ENCRYPTION_KEY=

# ── Reputazione URL ──────────────────────────────────────────
# Google Safe Browsing v4 (gratuito): https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_KEY=
# Aggiornamento blocklist pubbliche (URLhaus, Phishing.Database). true/false
THREAT_FEEDS_ENABLED=true

# ── Twitch (facoltativo) ─────────────────────────────────────
# https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Segreto HMAC per verificare le firme EventSub. openssl rand -hex 32
TWITCH_EVENTSUB_SECRET=

# ── Storage ──────────────────────────────────────────────────
# Cartella per allegati archiviati, snapshot e cache OCR
STORAGE_DIR=./storage

# ── Log ──────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
NODE_ENV=development
